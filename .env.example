ADMIN_USER=admin
ADMIN_PASSWORD=admin
FEEDBASKET_ADMIN_EMAIL=

# Keep empty to disable google based login
FEEDBASKET_GOOGLE_CLIENT_ID=
FEEDBASKET_GOOGLE_CLIENT_SECRET=
FEEDBASKET_SESSION_SECRET=

BASE_DIR="${HOME}/feedbasket"
LOGS_DIR="${BASE_DIR}/logs"
DB_DIR="${BASE_DIR}/db"
BACKUP_DIR="${BASE_DIR}/backups"

