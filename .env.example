ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Keep empty to disable google based login
FEEDBASKET_GOOGLE_CLIENT_ID=
FEEDBASKET_GOOGLE_CLIENT_SECRET=
FEEDBASKET_SESSION_SECRET=

BASE_DIR="${HOME}/feedbasket"
LOGS_DIR="${BASE_DIR}/logs"
DB_DIR="${BASE_DIR}/db"
BACKUP_DIR="${BASE_DIR}/backups"
BACKUP_PREFIX=backups/
# Leave empty to use R2 when configured, or set to local or r2.
BACKUP_DESTINATION=

# R2 credentials for PDF uploads and backups.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PDF_PREFIX=pdfs/

# Set these to the owner of the host directories when needed.
# FEEDBASKET_UID=1000
# FEEDBASKET_GID=1000
